    "@repo/tailwind-config": "workspace:*",
    "@storybook/nextjs": "^10.0.1",
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^10.0.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0"
