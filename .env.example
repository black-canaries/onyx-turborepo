# Convex Backend
# Get your deployment URL from https://dashboard.convex.dev
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_URL=

# For local development, you can use the same URL for all three
# Example: https://your-deployment.convex.cloud

# Convex Auth
# Your application URL (required for email verification, password reset, etc.)
SITE_URL=http://localhost:3000
# For production, use your actual domain (e.g., https://yourdomain.com)

# Supabase (if using)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
